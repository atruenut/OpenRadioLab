  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "OpenRadio Lab - beginner-first SDR learning environment"
      VALUE "ProductName", "OpenRadio Lab"
      VALUE "FileVersion", "0.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
